<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>br.com.sawcunhaos</groupId>
        <artifactId>scos-foundation</artifactId>
        <version>1.2.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>scos-foundation-exception</artifactId>
    <name>SCOS Foundation Exception</name>
    <description>Exception handling module providing centralized exception management and standardized error responses for SCOS projects</description>
    <url>https://github.com/SawCunhaOS/SawCunhaOS-Foundation</url>
    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>Apache License 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
            <comments>A business-friendly OSS license</comments>
        </license>
    </licenses>

    <scm>
        <url>https://github.com/SawCunhaOS/SawCunhaOS-Foundation</url>
        <connection>scm:git:git://github.com/SawCunhaOS/SawCunhaOS-Foundation.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/SawCunhaOS/SawCunhaOS-Foundation.git</developerConnection>
        <tag>HEAD</tag>
    </scm>

    <developers>
        <developer>
            <id>sawcunha</id>
            <name>Sawcunha Community</name>
            <email>community@sawcunha.io</email>
            <url>https://github.com/sawcunha</url>
            <organization>SawCunha Open System</organization>
            <organizationUrl>https://github.com/SawCunhaOS</organizationUrl>
            <roles>
                <role>architect</role>
                <role>maintainer</role>
            </roles>
            <timezone>-3</timezone>
        </developer>
    </developers>

    <organization>
        <name>SawCunha Open System</name>
        <url>https://github.com/SawCunhaOS</url>
    </organization>

    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/SawCunhaOS/SawCunhaOS-Foundation/issues</url>
    </issueManagement>

    <ciManagement>
        <system>GitHub Actions</system>
        <url>https://github.com/SawCunhaOS/SawCunhaOS-Foundation/actions</url>
    </ciManagement>


    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Story 1.14: scos-foundation-utils removed from the reactor. ExceptionsHandler uses
             core.exception.ScosException, core.enums.ScosExceptionCode, and
             core.specification.LocaleService directly — previously arrived transitively via
             scos-foundation-utils (which itself depends on core), now explicit. -->
        <dependency>
            <groupId>br.com.sawcunhaos</groupId>
            <artifactId>scos-foundation-core</artifactId>
        </dependency>
        <!-- ExceptionsHandler uses jakarta.servlet.http.HttpServletRequest and Spring MVC types
             (@ExceptionHandler, ResponseEntity). Previously arrived transitively via
             scos-foundation-utils's spring-boot-starter-web; now explicit since Story 1.12 removed
             that transitive path (utils no longer needs spring-boot-starter-web itself). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
