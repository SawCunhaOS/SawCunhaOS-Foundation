    <modules>
        <!-- *-api modules come first: they have zero runtime dependencies (leaves of the graph).
             audit/jdempotent depend on audit-api/jdempotent-api (annotations only, see Story 1.5).
             validation-api's annotations moved from utils in Story 1.9, alongside the
             ConstraintValidator implementations in validation (its dependent, below).
             codegen is also a dependency-free leaf (Story 1.14) — resource-only jar with no Java
             code, hosting the OpenAPI Generator Mustache templates rescued from utils/ (originally
             concluded dead code by mistake, corrected during Story 1.14's review — see its Debug
             Log); nothing in this reactor depends on it, it's a jar consumed externally. -->
        <module>audit-api</module>
        <module>jdempotent-api</module>
        <module>validation-api</module>
        <module>codegen</module>
        <!-- core comes before privacy/utils: utils depends on core (zero-Spring utilities, Story 1.7).
             privacy comes before utils: utils depends on privacy (masking beans).
             spring comes right after core: it depends only on core (generic Spring aspects, Story
             1.8) — utils does NOT depend on it (nothing left in utils consumes it after the move).
             validation comes right after spring (Fase 4 of the origin plan: second leaf module out,
             depends on core + validation-api only, see Story 1.9) — utils does NOT depend on it.
             cache comes right after validation (Fase 4 of the origin plan: third leaf module out,
             depends on core + spring-boot-starter-cache + spring-boot-starter-data-redis only, see
             Story 1.10) — utils does NOT depend on it; jdempotent depends on it directly instead
             (PolymorphicRedisSerializer, AD-1).
             jpa comes right after cache (Fase 4 of the origin plan: fourth leaf module out, first
             leaf depending on another leaf — core + validation + spring-boot-starter-data-jpa +
             querydsl-jpa + liquibase-core (optional) + jackson-databind, see Story 1.11) — utils
             does NOT depend on it; audit depends on it directly instead (BaseLiquibaseProperties).
             web comes right after jpa (Fase 4 of the origin plan: fifth and last leaf module out,
             the most coupled — core + cache + privacy simultaneously, see Story 1.12) — utils does
             NOT depend on it.
             feign is independent of the Fase 4 sequence above (Story 1.13 depends only on core +
             feign-core, same shape as spring) — listed last among this Fase-4-plus-feign leaf group
             purely by story number, not because it depends on any of them. (privacy/exception/
             audit/jdempotent/archtest below are pre-existing or downstream modules, not part of this
             leaf-extraction group. utils itself is gone — Story 1.14 emptied it of all classes across
             Stories 1.7-1.13 and removed it from the reactor entirely.) -->
        <module>core</module>
        <module>spring</module>
        <module>validation</module>
        <module>cache</module>
        <module>jpa</module>
        <module>web</module>
        <module>feign</module>
        <module>privacy</module>
        <module>exception</module>
        <module>audit</module>
        <module>jdempotent</module>
        <!-- archtest depende de todos os módulos acima em escopo test (AD-5). A ordem de build real
             é decidida pelo Maven via topologia de dependências, não pela ordem de listagem aqui;
             listado por último só por legibilidade. -->
        <module>archtest</module>
    </modules>

