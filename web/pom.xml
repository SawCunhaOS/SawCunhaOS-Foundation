<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>br.com.sawcunhaos</groupId>
        <artifactId>scos-foundation</artifactId>
        <version>1.2.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>scos-foundation-web</artifactId>
    <name>SCOS Foundation Web</name>
    <description>REST support module (ScosController, ScosRequestGET/POST/PUT/DELETE/PATCH with
        @Cacheable built in, logging filters with PII masking, pagination/response DTOs) so
        consumers can wire controllers without assembling the integration by hand. Depends on
        core + cache + privacy (Story 1.12).</description>
    <url>https://github.com/SawCunhaOS/SawCunhaOS-Foundation</url>
    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>Apache License 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
            <comments>A business-friendly OSS license</comments>
        </license>
    </licenses>

    <scm>
        <url>https://github.com/SawCunhaOS/SawCunhaOS-Foundation</url>
        <connection>scm:git:git://github.com/SawCunhaOS/SawCunhaOS-Foundation.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/SawCunhaOS/SawCunhaOS-Foundation.git</developerConnection>
        <tag>HEAD</tag>
    </scm>

    <developers>
        <developer>
            <id>sawcunha</id>
            <name>Sawcunha Community</name>
            <email>community@sawcunha.io</email>
            <url>https://github.com/sawcunha</url>
            <organization>SawCunha Open System</organization>
            <organizationUrl>https://github.com/SawCunhaOS</organizationUrl>
            <roles>
                <role>architect</role>
                <role>maintainer</role>
            </roles>
            <timezone>-3</timezone>
        </developer>
    </developers>

    <organization>
        <name>SawCunha Open System</name>
        <url>https://github.com/SawCunhaOS</url>
    </organization>

    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/SawCunhaOS/SawCunhaOS-Foundation/issues</url>
    </issueManagement>

    <ciManagement>
        <system>GitHub Actions</system>
        <url>https://github.com/SawCunhaOS/SawCunhaOS-Foundation/actions</url>
    </ciManagement>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>br.com.sawcunhaos</groupId>
            <artifactId>scos-foundation-core</artifactId>
        </dependency>
        <dependency>
            <groupId>br.com.sawcunhaos</groupId>
            <artifactId>scos-foundation-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>br.com.sawcunhaos</groupId>
            <artifactId>scos-foundation-privacy</artifactId>
        </dependency>

        <!-- Only runtime dependencies allowed (AC #1 / Dev Notes): spring-boot-starter-web,
             spring-data-commons. No Redis config here (that's cache's job), no Feign (Story 1.13). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-commons</artifactId>
        </dependency>

        <!-- ScosFilterProperties uses @RefreshScope for dynamic reload via Spring Cloud Config;
             same narrow dependency the cache module already uses for the same annotation. -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-context</artifactId>
        </dependency>

        <!-- JacksonXmlUtils builds an XmlMapper (Jackson 3) directly; not pulled transitively by
             spring-boot-starter-web (which stays on JSON only). Brings jackson-databind transitively. -->
        <dependency>
            <groupId>tools.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-xml</artifactId>
        </dependency>

        <!-- Several moved classes use lombok's @Data/@Builder/@RequiredArgsConstructor/
             @NoArgsConstructor/@AllArgsConstructor/@Slf4j. -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Story 2.9: moved here with ExceptionsHandler/ExceptionUtils, which use
             AccessDeniedException/AuthorizationDeniedException. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
        </dependency>
        <!-- Story 2.9: moved here with ExceptionsHandler/ExceptionUtils, which use
             jakarta.validation.* (ConstraintViolationException and friends). Kept as the
             full starter (not just jakarta.validation-api): retrospective of Épico 2 tried
             swapping this for the lighter API-only jar, but a real @Validated/@Min dispatch
             test (ExceptionsHandlerDomainDispatchTest) then failed 500 instead of 400 —
             Spring's method-validation infra needs an actual Bean Validation provider
             (Hibernate Validator), not just the API, to evaluate constraints at all. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Story 2.9: moved here with ValidationAnnotationCountListener, which uses
             @CPF/@CNPJ/@TaxIdentifier/@ZipCode. -->
        <dependency>
            <groupId>br.com.sawcunhaos</groupId>
            <artifactId>scos-foundation-validation-api</artifactId>
        </dependency>

        <!-- ArchUnit is test scope, version managed by the parent (Story 1.4). -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Test-only: LoggingFilterMaskingE2ETest drives the filters through a standalone
             MockMvc instance (org.springframework.test.web.servlet.*). -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Story 2.9: needed for @WebMvcTest (full Boot-autoconfigured MVC context), required by
             ExceptionsHandlerHandleExceptionInternalTest to exercise
             spring.mvc.throw-exception-if-no-handler-found — WebMvcAutoConfiguration only runs in an
             autoconfigured context, not a raw MockMvcBuilders.standaloneSetup() one. Same pattern
             already used by jdempotent/pom.xml and privacy/pom.xml, no exclusions. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Story 2.9: on Spring Boot 4.x, @WebMvcTest itself was split out of
             spring-boot-test-autoconfigure into this dedicated slice module (not needed pre-4.0,
             where spring-boot-starter-test alone was enough) — without it, @WebMvcTest doesn't
             resolve even though spring-boot-starter-test is present. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
